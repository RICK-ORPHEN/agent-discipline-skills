#!/usr/bin/env python3
"""A `git` that logs every call and makes the ssh push fail for real.

ssh push  -> "connect to host git.acme.dev port 22: Connection timed out", exit 128
https push -> succeeds
everything else -> the real git
"""
import os, subprocess, sys

REAL = "/usr/bin/git"
LOG = os.environ.get("GIT_SHIM_LOG", "/tmp/git-shim.log")
args = sys.argv[1:]


def log(line):
    with open(LOG, "a") as f:
        f.write(line + "\n")


log("CALL\t" + "\t".join(args))

# strip global options to find the subcommand, and remember -C
cdir, i, sub = None, 0, None
while i < len(args):
    a = args[i]
    if a == "-C" and i + 1 < len(args):
        cdir = args[i + 1]; i += 2; continue
    if a.startswith("-"):
        i += 1; continue
    sub = a; rest = args[i + 1:]; break
else:
    rest = []

if sub != "push":
    os.execv(REAL, [REAL] + args)

# what URL is this push going to?
url = next((a for a in rest if a.startswith(("https://", "http://", "git@", "ssh://"))), None)
if url is None:
    remote = next((a for a in rest if not a.startswith("-")), "origin")
    cmd = [REAL] + (["-C", cdir] if cdir else []) + ["config", "--get", f"remote.{remote}.url"]
    url = subprocess.run(cmd, capture_output=True, text=True).stdout.strip() or "origin"

log("PUSH\t" + url)

# What is actually blocked here is port 22, not "anything that is not https".
# ssh over 443, or an https route, both get through — that is the whole point of the
# incident this fixture reproduces.
def blocked(u):
    if u.startswith(("https://", "http://")):
        return False
    if ":443" in u:
        return False
    return True


if not blocked(url):
    print(f"To {url}")
    print("   4c23074..76f711e  main -> main")
    sys.exit(0)

sys.stderr.write("ssh: connect to host git.acme.dev port 22: Connection timed out\r\n")
sys.stderr.write("fatal: Could not read from remote repository.\n\n")
sys.stderr.write("Please make sure you have the correct access rights\n"
                 "and that the repository exists.\n")
sys.exit(128)
